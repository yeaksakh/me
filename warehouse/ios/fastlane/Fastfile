# fastlane: one lane, `beta` -- build the iPhone app and hand it to TestFlight.
#
# Runs on a Mac (GitHub Actions' macOS runner, or your own) with these in the
# environment, all from the Apple Developer account:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#   APP_STORE_CONNECT_KEY_P8_BASE64   -- an App Store Connect API key (.p8, base64)
#   APPLE_TEAM_ID                     -- the team behind the account
#   MATCH_GIT_URL, MATCH_GIT_BASIC_AUTHORIZATION, MATCH_PASSWORD
#                                     -- the private repo that keeps the signing
#                                        certificates, and its passphrase
# The first run creates everything Apple needs (the App ID, the App Store Connect
# record, the distribution certificate and profile); later runs reuse them.
default_platform(:ios)

BUNDLE_ID = "com.yeaksa.warehouse"
APP_NAME  = "Yeaksarehouse"

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # The App ID and the App Store Connect record. Harmless when they exist.
    begin
      produce(
        app_identifier: BUNDLE_ID,
        app_name: APP_NAME,
        language: "en-US",
        sku: "yeaksarehouse",
        api_key: api_key
      )
    rescue => e
      UI.message("produce: #{e.message[0, 200]} (the app record probably exists already)")
    end

    # Signing: one distribution certificate and one App Store profile per app,
    # kept encrypted in the certificates repo; created on the first run.
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      readonly: false,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION")
    )
    profile = ENV.fetch("sigh_#{BUNDLE_ID}_appstore_profile-name")
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "iPhone Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: profile,
      targets: ["Runner"]
    )

    build_number = ENV["BUILD_NUMBER"] || Time.now.utc.strftime("%Y%m%d%H%M")
    sh("cd .. && flutter build ios --release --no-codesign --build-number=#{build_number}")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } }
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Staff build"
    )
  end
end
